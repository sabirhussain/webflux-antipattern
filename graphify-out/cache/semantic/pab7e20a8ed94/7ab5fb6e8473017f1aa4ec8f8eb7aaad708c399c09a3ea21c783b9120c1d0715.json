{
  "nodes": [
    {
      "id": "readme_webflux_antipattern_repo",
      "label": "webflux-antipattern demo repository",
      "file_type": "document",
      "source_file": "README.md",
      "source_location": "L1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Teaches WebFlux antipatterns by implementing the same feature twice (wrong way and recommended way), switchable at runtime via a Spring profile."
    },
    {
      "id": "readme_multi_tenant_context_propagation",
      "label": "Multi-tenant context propagation",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "L3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "readme_thread_hopping",
      "label": "WebFlux thread hopping (subscribeOn, pooled schedulers, event-loop workers)",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "L7-L10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "WebFlux execution hops across threads, so per-thread storage like ThreadLocal cannot reliably carry request-scoped state through a reactive pipeline."
    },
    {
      "id": "readme_threadlocal_antipattern",
      "label": "Antipattern 1: ThreadLocal/InheritableThreadLocal for request-scoped state",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "L18-L21",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A plain ThreadLocal does not travel with execution when WebFlux hops threads, so the tenant stored by the filter is gone or stale downstream."
    },
    {
      "id": "readme_stale_pooled_thread_context",
      "label": "Antipattern 2: Stale data from reusing a pooled thread's inherited context",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "L22-L28",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Even with InheritableThreadLocal a worker copies the value only once at creation; a pooled worker that inherited tenant A keeps serving tenant A's data after the request moved to tenant B, returning wrong-tenant data rather than an error."
    },
    {
      "id": "readme_eager_evaluation_antipattern",
      "label": "Antipattern 3: Eager evaluation of per-subscription state",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "L29-L34",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Reading the tenant context synchronously at call time, before the Mono is built, bakes in a stale tenant if the context changes before subscription."
    },
    {
      "id": "readme_reactor_context",
      "label": "Reactor Context",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "L9-L10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Reactor Context travels with the subscription instead of the thread, so it reliably carries request-scoped state such as the tenant regardless of which thread executes the work."
    },
    {
      "id": "readme_mono_defer_defercontextual",
      "label": "Mono.defer / Mono.deferContextual lazy resolution",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "L36-L39",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Resolving state inside Mono.defer(...) / Mono.deferContextual(...) reads it at subscription time rather than call time, making it immune to thread hand-off and eager-evaluation bugs."
    },
    {
      "id": "readme_profile_switching",
      "label": "Profile-gated antipattern vs recommended implementations",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "L41-L45",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Mirrored antipattern/recommended sub-packages are selected by Spring profile via @AntiPattern / @Recommended so the same feature can be demonstrated both ways at runtime."
    },
